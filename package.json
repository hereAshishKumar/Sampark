{
  "name": "sampark",
  "version": "1.0.0",
  "type": "module",
  "description": "संपर्क (Sampark) — Rural Phone-to-Email Platform",
  "private": true,
  "scripts": {
    "start:backend": "cd apps/backend && npm start",
    "start:frontend": "cd apps/frontend && npm run dev",
    "build:frontend": "cd apps/frontend && npm run build",
    "send:test-mail": "node scripts/send-test-email.js",
    "docker:up": "docker compose up -d --build",
    "docker:down": "docker compose down"
  },
  "devDependencies": {
    "nodemailer": "^6.10.1"
  }
}
